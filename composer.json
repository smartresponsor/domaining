{
  "name": "domaining/domain",
  "description": "Smart Responsor Domaining component for externally registered custom-domain lifecycle.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "repositories": [
    {"type": "path", "url": "../Administering", "options": {"symlink": true}},
    {"type": "path", "url": "../Cruding", "options": {"symlink": true}},
    {"type": "path", "url": "../Interfacing", "options": {"symlink": true}},
    {"type": "path", "url": "../Objecting", "options": {"symlink": true}},
    {"type": "path", "url": "../Viewing", "options": {"symlink": true}}
  ],
  "require": {
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/orm": "^3.0",
    "administering/administration": "*@dev",
    "cruding/crud": "*@dev",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "*@dev",
    "objecting/object": "*@dev",
    "php": "^8.4",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/string": "^8.1",
    "symfony/uid": "^8.1",
    "symfony/validator": "^8.1",
    "viewing/view": "*@dev",
    "symfony/yaml": "^8.1",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "symfony/http-kernel": "^8.1",
    "symfony/runtime": "^8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Domaining\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Domaining\\Test\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "require": "8.0.*"
    }
  },
  "suggest": {
    "symfony/twig-bundle": "Render Domaining surfaces through host/application Twig templates when Interfacing templates are installed."
  }
}
