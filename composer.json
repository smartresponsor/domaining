{
  "name": "domaining/domain",
  "description": "Smart Responsor Domaining component for externally registered custom-domain lifecycle.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "repositories": [
    {"type": "path", "url": "../Administering", "options": {"symlink": true, "versions": {"administering/administration": "dev-master"}}},
    {"type": "path", "url": "../Collectioning", "options": {"symlink": true, "versions": {"collectioning/collection": "dev-master"}}},
    {"type": "path", "url": "../Cruding", "options": {"symlink": true, "versions": {"cruding/crud": "dev-master"}}},
    {"type": "path", "url": "../Interfacing", "options": {"symlink": true, "versions": {"interfacing/interface": "dev-master"}}},
    {"type": "path", "url": "../Objecting", "options": {"symlink": true, "versions": {"objecting/object": "dev-master"}}},
    {"type": "path", "url": "../Tabling", "options": {"symlink": true, "versions": {"tabling/table": "dev-master"}}},
    {"type": "path", "url": "../Viewing", "options": {"symlink": true, "versions": {"viewing/view": "dev-master"}}}
  ],
  "require": {
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/orm": "^3.0",
    "administering/administration": "dev-master",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "php": "^8.4",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/string": "^8.1",
    "tabling/table": "dev-master",
    "symfony/uid": "^8.1",
    "symfony/validator": "^8.1",
    "viewing/view": "dev-master",
    "symfony/yaml": "^8.1",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "symfony/http-kernel": "^8.1",
    "symfony/runtime": "^8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Domaining\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Domaining\\Test\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "phpstan": "phpstan analyse src test --level=6 --memory-limit=1G",
    "qa": [
      "@phpstan",
      "@test"
    ]
  },
  "extra": {
    "symfony": {
      "require": "8.0.*"
    }
  },
  "suggest": {
    "symfony/twig-bundle": "Render Domaining surfaces through host/application Twig templates when Interfacing templates are installed."
  }
}
