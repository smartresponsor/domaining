{
  "name": "domaining/domain",
  "description": "Smart Responsor Domaining component for externally registered custom-domain lifecycle.",
  "type": "symfony-bundle",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repositories": [
    {
      "type": "path",
      "url": "../Administering",
      "options": {
        "symlink": true,
        "versions": {
          "administering/administration": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Failing",
      "options": {
        "symlink": true,
        "versions": {
          "failing/failure": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ],
  "require": {
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/orm": "^3.0",
    "administering/administration": "dev-master",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "failing/failure": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "php": "^8.4",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/string": "^8.1",
    "tabling/table": "dev-master",
    "symfony/uid": "^8.1",
    "symfony/validator": "^8.1",
    "viewing/view": "dev-master",
    "symfony/yaml": "^8.1",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "symfony/http-kernel": "^8.1",
    "symfony/runtime": "^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^4.0",
    "gating/gate": "dev-master",
    "symfony/panther": "^2.4",
    "symfony/test-pack": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "App\\Domaining\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Domaining\\Test\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
    "cs:fix": "php-cs-fixer fix --using-cache=no",
    "doctrine:schema:validate": "@php bin/console doctrine:schema:validate --env=test",
    "doctrine:migrations:status": "@php bin/console doctrine:migrations:status --env=test --no-interaction",
    "doctrine:schema:parity": [
      "@doctrine:schema:validate",
      "@php bin/console doctrine:migrations:up-to-date --env=test --no-interaction"
    ],
    "test": "phpunit",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "test:behavioral-coverage": "@php tool/generate-behavioral-ui-coverage.php",
    "phpstan": "phpstan analyse src test --level=6 --memory-limit=1G",
    "qa": [
      "@phpstan",
      "@test"
    ],
    "gate": "@php vendor/bin/gating check --target=.",
    "quality": [
      "@cs:check",
      "@phpstan",
      "@test",
      "@gate"
    ]
  },
  "extra": {
    "symfony": {
      "require": "8.1.*"
    }
  },
  "suggest": {
    "symfony/twig-bundle": "Render Domaining surfaces through host/application Twig templates when Interfacing templates are installed."
  }
}
