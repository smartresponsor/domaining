<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" cacheDirectory=".phpunit.cache" colors="true">
    <testsuites>
        <testsuite name="Domaining">
            <directory>test</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="DATABASE_URL" value="sqlite:///:memory:"/>
    </php>
</phpunit>


